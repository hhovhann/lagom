# Copy to .env (never commit it): cp .env.example .env
# `lagom serve` loads .env automatically; real environment variables win.

# --- Model providers: fill only the ones your config uses -------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Protect the gateway itself (recommended for anything beyond localhost) -------
# Clients send:  Authorization: Bearer <LAGOM_API_KEY>
LAGOM_API_KEY=
# Separate token for /v1/stats, /metrics, /v1/admin/reset
LAGOM_ADMIN_KEY=
